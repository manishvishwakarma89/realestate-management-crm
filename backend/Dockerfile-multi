# ===============================================
# STAGE 1: Dependencies Stage (Slim)
# ===============================================
FROM node:21-alpine AS dependencies

LABEL maintainer="DevOps Team"
LABEL stage="dependencies"

WORKDIR /app

# Copy only package files
COPY package*.json ./

# Install all dependencies (prod + dev)
RUN npm ci && \
    npm cache clean --force

# ===============================================
# STAGE 2: Build Stage (Testing & Compilation)
# ===============================================
FROM node:21-alpine AS builder

LABEL maintainer="DevOps Team"
LABEL stage="builder"

WORKDIR /app

# Copy package files
COPY package*.json ./

# Copy dependencies from stage 1
COPY --from=dependencies /app/node_modules ./node_modules

# Copy application source code
COPY . .

# Run linting (optional - uncomment if you have lint script)
# RUN npm run lint

# Run tests (optional - uncomment if you have test script)
# RUN npm run test

# Build if needed (for TypeScript, etc.)
# RUN npm run build

# ===============================================
# STAGE 3: Production Dependencies Only
# ===============================================
FROM node:21-alpine AS prod-dependencies

LABEL maintainer="DevOps Team"
LABEL stage="prod-dependencies"

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ONLY production dependencies
RUN npm ci --only=production && \
    npm cache clean --force

# ===============================================
# STAGE 4: Final Production Image (Minimal)
# ===============================================
FROM node:21-alpine AS production

LABEL maintainer="DevOps Team"
LABEL description="Production Backend API"
LABEL version="1.0.0"


# Create non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
    

# Set working directory
WORKDIR /app

# Copy package files
COPY --chown=appuser:appgroup package*.json ./

# Copy production dependencies from prod-dependencies stage
COPY --from=prod-dependencies --chown=appuser:appgroup /app/node_modules ./node_modules

# Copy application code from builder stage
COPY --from=builder --chown=appuser:appgroup /app . .

# Create directories for logs and temp files if needed
RUN mkdir -p /app/logs && chown -R appuser:appgroup /app/logs

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 5000

# Start application
CMD ["npm", "run", "dev", "--", "--host"]
