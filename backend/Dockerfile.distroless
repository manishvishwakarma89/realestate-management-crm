# ===============================================
# STAGE 1: Dependencies Stage (all deps, for build/test)
# ===============================================
FROM node:22-alpine AS dependencies

LABEL maintainer="DevOps Team"
LABEL stage="dependencies"

WORKDIR /app

COPY package*.json ./
RUN npm ci && \
    npm cache clean --force

# ===============================================
# STAGE 2: Build Stage (lint, test, compile)
# ===============================================
FROM node:22-alpine AS builder

LABEL maintainer="DevOps Team"
LABEL stage="builder"

WORKDIR /app

COPY package*.json ./
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .

# Pre-create runtime dirs here — distroless has no shell to mkdir later
RUN mkdir -p /app/logs

# Uncomment as needed:
# RUN npm run lint
# RUN npm run test
# RUN npm run build          # e.g. TypeScript -> dist/

# ===============================================
# STAGE 3: Production Dependencies Only
# ===============================================
FROM node:22-alpine AS prod-dependencies

LABEL maintainer="DevOps Team"
LABEL stage="prod-dependencies"

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && \
    npm cache clean --force

# ===============================================
# STAGE 4: Final Production Image (Distroless)
# ===============================================
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS production

LABEL maintainer="DevOps Team"
LABEL description="Backend API - distroless production image"
LABEL version="1.0.0"

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

# Production node_modules only
COPY --from=prod-dependencies --chown=nonroot:nonroot /app/node_modules ./node_modules

# App code (built output + package files + logs dir + db.json + server files) from builder stage
COPY --from=builder --chown=nonroot:nonroot /app/package*.json ./
COPY --from=builder --chown=nonroot:nonroot /app/db.json ./db.json
COPY --from=builder --chown=nonroot:nonroot /app/routes ./routes
COPY --from=builder --chown=nonroot:nonroot /app/models ./models
COPY --from=builder --chown=nonroot:nonroot /app/middleware ./middleware
COPY --from=builder --chown=nonroot:nonroot /app/controllers ./controllers

EXPOSE 5000

# ENTRYPOINT is already "node" in this image — CMD is just the entry file.
CMD ["server-json.js"]