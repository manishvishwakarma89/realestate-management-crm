# ===============================================
# STAGE 1: Build Stage (with all dependencies)
# ===============================================
FROM node:22-alpine AS builder

# Add security labels
LABEL maintainer="manish.kumar.v@ramanujan.du.ac.in"
LABEL description="Production-ready Node.js application"

WORKDIR /app

# Copy package.json and package-lock.json for dependency installation
COPY package*.json ./
RUN npm ci && \
    npm cache clean --force
COPY . .

# Build the Vite frontend
RUN npm run build

# ===============================================
# STAGE 2: Runtime Stage (distroless with static server)
# ===============================================
FROM node:22-alpine AS runtime

WORKDIR /app

# Install a minimal static server
RUN npm install -g http-server

# Copy the built frontend from the builder stage
COPY --from=builder /app/dist ./dist
COPY ./start.sh ./start.sh
RUN chmod +x ./start.sh

EXPOSE 8080

# Serve the static files with SPA routing
CMD ["./start.sh"]