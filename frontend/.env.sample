# Server encryption key for API key storage (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Required in production. Outside production it is optional: when unset, a key is
# auto-generated and written to a file named .encryption-key next to the SQLite
# database (not inside it), with 0600 permissions. Precedence: this env var, then
# that key file, then a legacy key found in the old settings table (migrated to
# the file on first boot), then a freshly generated key.

ENCRYPTION_KEY=password123456789012345678901234567890


# Backend API URL for Docker networking (default: http://backend:5000)
VITE_API_URL=http://backend:5000

# Server port (default: 3001)
PORT=3001

# Network interface the server listens on. Default '::' (dual-stack IPv4+IPv6);
# hosts with IPv6 disabled fall back to IPv4 automatically. Set 0.0.0.0 for
# IPv4-only or 127.0.0.1 to restrict to localhost. (Different from HOST_BIND
# below, which only affects Docker port publishing.)
# HOST=::
# 
# First-run setup: the first account is created through the dashboard. A browser
# on the same machine as the server can do this with no extra step. If the server
# is reachable from other devices, creating that first account also requires a
# one-time setup code, printed in the server logs at startup while no account
# exists. This stops a stranger from claiming a freshly exposed install.
# 
# Docker only: which host interface the container's port is published on.
# Defaults to 127.0.0.1, so the dashboard/API is reachable only from the
# machine running Docker. To open it to other devices on your LAN (e.g. a
# Raspberry Pi reached at http://192.168.1.x:3001), set HOST_BIND=0.0.0.0.
# Only do this on a trusted network — the proxy is single-user and guarded
# only by the unified API key.
# HOST_BIND=0.0.0.0
# 
# Max /v1 proxy requests per minute per client IP (default: 120). Set to 0
# to disable proxy rate limiting.
# PROXY_RATE_LIMIT_RPM=120
# 
# Max /api dashboard requests per minute per client IP (default: 600). This is a
# flood guard — login has its own per-email lockout and key export its own much
# tighter cap. Set to 0 to disable.
# ADMIN_RATE_LIMIT_RPM=600
# 
# JSON body limit in MB for the inference surfaces (/v1, /v1beta, /mcp,
# Ollama /api/*) — default: 25. Vision requests embed base64 images in the
# body and replay them with every turn, so large sessions can clear 10MB;
# this ceiling only gates parsing — inbound image normalization (below)
# shrinks the payload afterwards. Raise it if bigger payloads are rejected
# with 413 'request_too_large'.
# REQUEST_BODY_LIMIT_MB=25
# 
# Inbound image normalization: data-URL images over the threshold are
# downscaled to the long-edge cap and re-encoded (JPEG, or PNG only when the
# alpha channel carries real transparency) before routing, shrinking replayed
# screenshots ~6-10x. Also normalizes exotic formats upstreams reject
# (bmp/gif/tiff/avif/webp → jpeg/png); gif keeps its first frame only. Every
# upstream resizes internally anyway (OpenAI to 2048px, Anthropic to 1568px),
# so pixels beyond the cap are transport waste. Set IMAGE_NORMALIZE=off to
# disable entirely.
# IMAGE_NORMALIZE=on
# IMAGE_NORMALIZE_MAX_DIMENSION=2048
# IMAGE_NORMALIZE_THRESHOLD_KB=1024
# IMAGE_NORMALIZE_QUALITY=90
# 
# Outbound proxy for provider requests. Normally set in the dashboard
# (Keys → Outbound proxy); these env vars are for headless installs.
# Schemes: http, https, socks4, socks4a, socks5, socks5h. The `h`/`a` variants
# resolve DNS at the proxy, which is what you want on a DNS-poisoned network.
# Precedence: PROXY_URL → dashboard setting → ALL_PROXY → HTTPS_PROXY →
# HTTP_PROXY. The standard vars are also read in their lower-case spellings.
# PROXY_URL=socks5h://127.0.0.1:1080
# ALL_PROXY=socks5h://127.0.0.1:1080
# HTTPS_PROXY=http://proxy.corp.com:8080
# HTTP_PROXY=http://proxy.corp.com:8080
# 
# Application-layer Fetch Relay (opt-in). The relay target and its separate
# bearer credential use Fetch-Relay-Target and Fetch-Relay-Authorization.
# See docs/fetch-relay.md.
# PROXY_MODE=fetch-relay
# PROXY_URL=https://relay.example.workers.dev
# FETCH_RELAY_TOKEN=generate-a-long-random-token
# 
# IN DOCKER, 127.0.0.1 IS THE CONTAINER, NOT YOUR MACHINE. If the proxy runs
# on the host (Clash, v2rayN, sing-box, a corporate client), use the host's
# address instead, and make sure the proxy listens on more than loopback
# (Clash: `allow-lan: true`):
# PROXY_URL=socks5h://host.docker.internal:7890
# The bundled docker-compose.yml maps host.docker.internal to the host gateway
# so this works on plain Linux Docker too, not just Docker Desktop.
# 
# Hosts that must be reached directly, bypassing the proxy above. Comma-
# separated; a bare domain also covers its subdomains, and `*` disables the
# proxy entirely.
# NO_PROXY=localhost,127.0.0.1,.internal.corp
# 
# Local and LAN destinations (localhost, 127.0.0.0/8, ::1, 0.0.0.0, RFC1918 /
# ULA / CGNAT addresses) always bypass the proxy — a remote proxy has no route
# back to your own machine, and an IP literal makes Tor log "giving Tor only an
# IP address" and refuse the connection. That is the right default for a local
# Ollama / llama.cpp / LM Studio endpoint.
# Set this to true only if proxying them is the point — e.g. an `ssh -D`
# dynamic tunnel, where http://127.0.0.1:11434 through the SOCKS proxy is meant
# to reach the REMOTE host's Ollama.
# FREEAPI_PROXY_LOCAL_DESTINATIONS=true
# 
# Per-provider daily request cap, named PROVIDER_DAILY_REQUEST_CAP_<PLATFORM>
# (platform name upper-cased). Overrides the built-in default for that provider;
# set to 0 to disable the cap. Example — cap OpenRouter at 50 requests/day:
# PROVIDER_DAILY_REQUEST_CAP_OPENROUTER=50
# 
# Per-provider chat HTTP timeout in milliseconds, named
# PROVIDER_TIMEOUT_<PLATFORM> (platform name upper-cased). Overrides the
# built-in default for that provider (60s for most OpenAI-compatible platforms,
# 180s NVIDIA, 120s Ollama Cloud / AI Horde / custom providers, 60s Google as
# registered). On streaming requests this value also serves as the FIRST-BYTE
# grace budget: how long the stream may stay silent before its first byte
# (issue #584 — providers like NVIDIA NIM send SSE headers instantly, then
# prefill long prompts for minutes). Set to 0 to disable the timeout entirely.
# Read at startup. Example — give NVIDIA NIM's slow reasoning models 5 minutes:
# PROVIDER_TIMEOUT_NVIDIA=300000
# 
# ModelScope (魔搭) validates API keys with a paid 1-token chat completion
# (GET /v1/models does not enforce auth), which spends the account's
# magic-grain (魔粒) quota per probe — observed as 2 魔粒 per ultra-tier
# request. To stop the 5-minute health pass from burning ~288 paid probes
# per key per day, a successful validation is cached per key for this long
# (milliseconds, default 86400000 = 24h). Set to 0 to probe on every pass.
# A revoked key is still caught by the next real request's 401.
# MODELSCOPE_VALIDATE_CACHE_MS=86400000
# 
# Mid-stream inactivity timeout for streaming responses, in milliseconds
# (default: 90000). If an SSE stream goes this long without a single byte
# AFTER the first byte arrived, the gateway gives up on it (before any output
# reached the client this fails over to the next candidate; after output was
# sent the stream ends with an error frame). Time-to-FIRST-byte is governed by
# the chat timeout above instead (whichever of the two is larger). Providers
# that queue heavily on their free tiers can pause longer than 90s mid-stream —
# raise this if streamed responses stop early. Set to 0 to disable the stall
# watchdog entirely.
# PROVIDER_STREAM_STALL_TIMEOUT_MS=90000
# 
# Per-provider variant, named PROVIDER_STREAM_STALL_TIMEOUT_<PLATFORM>
# (platform name upper-cased). Precedence: per-platform > global (above) >
# built-in 90s default. Example — let Ollama Cloud pause 4 minutes mid-stream
# without loosening the watchdog everywhere else:
# PROVIDER_STREAM_STALL_TIMEOUT_OLLAMA=240000
# 
# Wall-clock budget for provider failover, in milliseconds (default: 45000).
# A request that keeps failing over stops STARTING new attempts once this much
# time has passed and returns the exhaustion error instead (the first attempt
# always runs; an in-flight attempt is never cut off). Set to 0 to disable and
# retry until the attempt cap. Can also be set at runtime via the
# fallback_time_budget_ms settings key, which takes precedence.
156: # FALLBACK_TIME_BUDGET_MS=45000
# 
# Add X-Fallback-Detail to responses (default: off). X-Fallback-Trail already
# names every hop that failed and why; the detail header adds what each one
# COST — "groq/llama-3.3-70b key1=rate_limited t=0+39000ms msg=..." — so a
# caller can tell one 39s stall apart from four fast failures without opening
# the dashboard. Off by default because it puts hop timings and provider error
# text on the response. Can also be set at runtime via the
# expose_fallback_detail_header settings key, which takes precedence.
163: # FALLBACK_DETAIL_HEADER=1
# 
# Check tool-call arguments against the schema the caller declared, and fail
# over to another model when they violate it (default: off). lib/tool-args.ts
# already repairs what it can prove is repairable; this catches what is left,
# which today reaches Anthropic clients as a tool_use block with `input: {}` and
# no indication anything went wrong. A different model usually gets the same
# call right. A different model usually gets the same
170: # call right. A different model usually gets the same
174: # call right. A different model usually gets the same
179: # Applies wherever the turn can still fail over — every non-streaming surface,
174: # and the streams that buffer tool calls to the end (/v1/chat/completions,
175: # /v1/messages, the Gemini and Ollama emulations). /v1/responses streaming is
176: # the exception: it commits on the first tool-call delta, before the arguments
177: # are complete, so a verdict there could only break a stream in flight.
177: # Can also be set at runtime via the validate_tool_arguments settings key,
179: # which takes precedence.
179: # VALIDATE_TOOL_ARGUMENTS=1
180: 
181: # Request guardrails, both OFF (0) by default. Also runtime-tunable via the
183: # request_max_tokens_budget / max_consecutive_upstream_fails settings keys
184: # (dashboard API PUT /api/settings/guardrails), which take precedence.
185: #
185: # Per-request token budget: estimated input + requested max_tokens must fit
186: # this ceiling or the request is rejected with a 413 before any provider is
188: # tried; a request that sent no max_tokens gets its output capped to the
189: # remainder instead.
190: # REQUEST_MAX_TOKENS_BUDGET=0
191: 
191: # Failover circuit breaker: after this many consecutive upstream failures in
194: # one request, stop the failover chain with a 503 instead of trying every
195: # remaining candidate of an unhealthy pool.
195: # MAX_CONSECUTIVE_UPSTREAM_FAILS=0
197: 
197: # Opt-in response cache. When on, a successful non-streaming /v1/chat/completions
198: # answer is stored in a bounded in-memory LRU keyed by a canonical hash of the
200: # request, so an IDENTICAL later request is served from memory without spending
200: # any provider quota. Exact match only (no fuzzy matching), so a near-miss never
200: # returns a different prompt's answer. Off by default; set to true to enable.
201: # Can also be toggled at runtime via the dashboard (PUT /api/cache/config), and
203: # per-request with the `X-FreeLLM-Cache: on|off` header.
203: # RESPONSE_CACHE=false
204: # Persist cached answers to SQLite so they survive a restart (the daily
209: # quota-reset re-run pattern). Only applies when the cache above is on. Note
209: # this writes PLAINTEXT model responses to the database file, which the
209: # memory-only cache never did; set it to false to keep caching but hold
209: # everything in memory, as before. Entries are removed from disk the moment
210: # they leave the in-memory cache (TTL expiry, eviction, DELETE /api/cache).
211: # RESPONSE_CACHE_PERSIST=true
212: # How long a cached answer stays fresh, in seconds (default: 3600 = 1 hour).
213: # RESPONSE_CACHE_TTL_SECONDS=3600
214: # Only cache requests at/below this temperature; higher temperatures want fresh
215: # variety, so they are never cached. Default 1.0 caches everything when enabled;
215: # lower it (e.g. 0.2) to cache only near-deterministic calls.
216: # RESPONSE_CACHE_MAX_TEMPERATURE=1.0
216: # Hard cap on stored entries; the least-recently-used are evicted past this.
218: # RESPONSE_CACHE_MAX_ENTRIES=5000
219: 
220: # Request-side prompt/context compression. The default is off. `lossless`
221: # applies whitespace hygiene, exact repeated-block references, and reversible
224: # tabular-JSON encoding; `standard` also filters tool output and superseded file
224: # reads; `aggressive` adds age/relevance/budget condensation. The dashboard can
225: # change this live under Settings. A request may lower the configured mode with
225: # `X-FreeLLM-Compress`, but cannot override a global `off` master switch.
225: # FREELLMAPI_COMPRESSION=off
226: 
228: # Custom-provider URL policy. Cloud metadata and link-local addresses
229: # (169.254.169.254, metadata.google.internal, fe80::/10, ...) are ALWAYS
230: # blocked as custom provider base URLs. By default localhost and private LAN
232: # addresses stay allowed so local Ollama / LM Studio / llama.cpp setups work.
234: # If you host FreeLLMAPI on a VPS or anywhere the dashboard is reachable by
235: # others, set this to also block loopback and RFC1918/ULA private ranges.
235: # FREEAPI_BLOCK_PRIVATE_PROVIDER_URLS=true
236: 
237: # Request analytics retention. Set either value to 0 to disable that limit.
238: REQUEST_ANALYTICS_RETENTION_DAYS=90
239: REQUEST_ANALYTICS_MAX_ROWS=100000
240: 
241: # Provider quota observation log (the audit trail behind the per-key quota
243: # state the dashboard shows). Only the newest row per pool is ever read, so the
243: # history is pruned daily by age and by count. 0 disables that half.
244: # QUOTA_OBSERVATIONS_RETENTION_DAYS=30
244: # QUOTA_OBSERVATIONS_MAX_ROWS=200000
245: 
246: # Persisted server logs behind the dashboard's log viewer. Only warn/error
249: # lines are written to the database (the live view is an in-memory ring), so
249: # these bounds are far tighter than the analytics ones above. Either value at 0
249: # disables that limit.
250: # SERVER_LOGS_RETENTION_DAYS=7
250: # SERVER_LOGS_MAX_ROWS=50000
253: 
253: # Per-request caller identity (client IP + User-Agent) recorded into request
254: # analytics and shown in the dashboard's "Recent calls" table. Set to false
255: # to store nulls instead (aggregate analytics are unaffected).
256: # REQUEST_ANALYTICS_LOG_CLIENT=true
258: 
259: # Optional SQLite location. Useful on hosts where only one directory is mounted
260: # persistently, or when you want to keep the DB outside server/data.
261: # FREEAPI_DB_PATH=/app/server/data/freellmapi.db
261: 
263: # Whether to restrict the directory holding the database to this account, so the
265: # SQLite -wal/-shm sidecars are protected too (they are created on first write,
265: # after any startup permission check could reach them). Done automatically for
265: # the default server/data directory and for any directory FreeLLMAPI creates
265: # itself; skipped for a FREEAPI_DB_PATH pointing somewhere pre-existing, since
265: # that may be a shared location this server should not be locking down. Set to 1
269: # if the directory belongs to this account alone, or 0 to disable entirely.
269: # FREEAPI_DB_DIR_HARDENING=1
269: 
270: # Optional encrypted SQLite backup. On startup, FreeLLMAPI restores this backup
272: # if the configured DB file is missing; while running, it uploads a fresh backup
274: # periodically. File paths and HTTP(S) URLs are supported.
274: # FREEAPI_DB_BACKUP_PATH=/app/server/data/freellmapi.db.backup
275: # FREEAPI_DB_BACKUP_URL=https://example.com/freellmapi.db.backup
276: # FREEAPI_DB_BACKUP_TOKEN=
278: # FREEAPI_DB_BACKUP_KEY=use-a-separate-64-char-hex-key-or-omit-to-use-ENCRYPTION_KEY
279: # FREEAPI_DB_BACKUP_INTERVAL_MS=300000
279: 
279: # Optional declarative startup config. Use either inline JSON or a path to a JSON
281: # file. It is applied idempotently after migrations on every boot.
283: # FREEAPI_CONFIG_PATH=/app/server/data/freellmapi.config.json
283: # FREEAPI_CONFIG_JSON={"keys":[{"platform":"groq","key":"gsk_...","label":"main"}],"routing":{"strategy":"balanced"}}
284: 
285: # Context handoff on model switch. When enabled, FreeLLMAPI injects a compact
287: # system message into the outbound request whenever a session switches from one
288: # model to another (e.g. after a fallback). Off by default.
288: # FREELLMAPI_CONTEXT_HANDOFF=on_model_switch
289: 
290: # Manual application update checker. Set to off to hide it from Settings and
291: # prevent Git discovery or outbound update-check requests. Enabled by default.
294: # This also switches off the automatic release reminder, which is a separate
294: # dashboard setting (Settings > General) and is off until turned on there.
294: # FREELLMAPI_UPDATE_CHECK=off
295: # Optional token used only for update checks against GitHub. The checker is
298: # anonymous by default; use a narrowly scoped token only if higher rate limits
298: # are needed. Generic GITHUB_TOKEN values are intentionally ignored.
299: # FREELLMAPI_UPDATE_GITHUB_TOKEN=
299: # FREELLMAPI_COMMIT_SHA and FREELLMAPI_INSTALL_METHOD are injected by official
300: # Docker and desktop builds and normally should not be set in .env.
301: 
302: # Comma-separated extra origins allowed to call the API from a browser.
304: # localhost:5173, 127.0.0.1:5173, [::1]:5173 are allowed by default for the
305: # Vite dev dashboard. Only set this if you serve the dashboard from a
305: # different host than the API (e.g. http://my-server.local).
306: # DASHBOARD_ORIGINS=http://my-server.local,http://192.168.1.50
307: 
308: # Content-Security-Policy `upgrade-insecure-requests` directive (#682).
309: # Auto (unset): emit only when the request arrives over TLS or behind an
310: # HTTPS reverse proxy (X-Forwarded-Proto: https). Plain-HTTP LAN installs
311: # (HOST_BIND=0.0.0.0, no TLS in front) stay renderable.
314: # true:  force the directive on even over plain HTTP (rarely useful).
314: # false: force it off even behind HTTPS (e.g. mixed-content reverse proxies).
314: # CSP_UPGRADE_INSECURE_REQUESTS=false
315: 
316: # Trust forwarded headers (X-Forwarded-For / X-Forwarded-Proto) from a reverse
317: # proxy so Analytics and IP-based rate limiting see the real client (#1024).
317: # Default (unset or false): do NOT trust forwarded headers — direct callers
320: # cannot spoof the client IP.
320: # true: trust every proxy hop (only use on a fully trusted network).
323: # A number: trust that many hops in front of the server (TRUST_PROXY=1 for a
324: # single reverse proxy such as Caddy, nginx or Traefik on the same host).
324: # Otherwise: a comma-separated list of proxy addresses/CIDRs to trust, e.g.
325: #   TRUST_PROXY=100.64.0.0/10,192.168.1.10
325: # TRUST_PROXY=false
325: 
327: # Per-model routing score multipliers (#738), JSON object of model id → 0..2.
329: # 1.0 leaves a model unchanged, below 1 demotes it, above 1 promotes it, and 0
330: # means the automatic router never picks it (Manual priority still can).
330: # Matching is by model id alone, across all platforms serving that id, and the
333: # match is exact and case-sensitive. Copy ids from the dashboard Models page:
333: # an id that matches nothing is silently ignored (the boot log flags it once the
333: # catalog has synced).
334: # MODEL_ROUTING_OVERRIDES={"gpt-4o": 0.2, "gpt-oss-120b": 1.5}
334: 
335: # --- Advanced / embedding ---------------------------------------------------
337: # Path to a prebuilt client `dist` directory to serve. Defaults to the bundled
338: # client build; set this only if you build the dashboard separately.
339: # CLIENT_DIST=/path/to/client/dist
339: # Explicit path to the .env file to load. Useful for embedders (e.g. the
340: # desktop app, where the code runs from inside a bundle). Defaults to ./.env.
343: # FREEAPI_ENV_PATH=/path/to/.env